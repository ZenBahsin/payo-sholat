rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Hardened Global Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidServerTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    // --- Entity Validation Blueprints ---
    function isValidUserProfile(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 100 &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 150)) &&
             (!('avatarUrl' in data) || data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 500)) &&
             data.city is string && data.city.size() >= 1 && data.city.size() <= 100 &&
             (!('region' in data) || data.region == null || (data.region is string && data.region.size() <= 100)) &&
             data.countryCode is string && data.countryCode in ['ID', 'MY'] &&
             (!('jakimZone' in data) || data.jakimZone == null || (data.jakimZone is string && data.jakimZone.size() <= 20)) &&
             data.timeZoneId is string && data.timeZoneId.size() >= 1 && data.timeZoneId.size() <= 60 &&
             data.latitude is number && data.latitude >= -90 && data.latitude <= 90 &&
             data.longitude is number && data.longitude >= -180 && data.longitude <= 180 &&
             (!('notificationPrefs' in data) || data.notificationPrefs == null || (data.notificationPrefs is map && data.notificationPrefs.size() <= 15)) &&
             isValidServerTimestamp(data.createdAt) &&
             isValidServerTimestamp(data.updatedAt);
    }

    function isValidPrayerLog(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.prayerDate is string && data.prayerDate.size() == 10 && data.prayerDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.prayerName is string && data.prayerName in ['subuh', 'zuhur', 'asar', 'maghrib', 'isya'] &&
             data.completed is bool &&
             data.prayMode is string && data.prayMode in ['sendiri', 'berjamaah_masjid'] &&
             isValidServerTimestamp(data.createdAt) &&
             isValidServerTimestamp(data.updatedAt);
    }

    function isValidQuranProgress(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.lastSurahNumber is int && data.lastSurahNumber >= 0 && data.lastSurahNumber <= 114 &&
             data.lastSurahName is string && data.lastSurahName.size() <= 100 &&
             data.lastAyah is int && data.lastAyah >= 0 && data.lastAyah <= 300 &&
             data.totalAyahsRead is int && data.totalAyahsRead >= 0 && data.totalAyahsRead <= 6236 &&
             data.khatamPercentage is int && data.khatamPercentage >= 0 && data.khatamPercentage <= 100 &&
             (!('bookmarks' in data) || data.bookmarks == null || (data.bookmarks is list && data.bookmarks.size() <= 50 && (data.bookmarks.size() == 0 || data.bookmarks[0] is string))) &&
             isValidServerTimestamp(data.createdAt) &&
             isValidServerTimestamp(data.updatedAt);
    }

    function isValidTasbihSession(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.dzikirTitle is string && data.dzikirTitle.size() >= 1 && data.dzikirTitle.size() <= 120 &&
             data.currentCount is int && data.currentCount >= 0 && data.currentCount <= 1000000 &&
             data.targetCount is int && data.targetCount >= 1 && data.targetCount <= 100000 &&
             isValidServerTimestamp(data.createdAt) &&
             isValidServerTimestamp(data.updatedAt);
    }

    // --- Collection: /users/{userId} (Profiles - PII strictly owner-only) ---
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'fullName', 'city', 'countryCode', 'timeZoneId', 'latitude', 'longitude', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'fullName', 'email', 'avatarUrl', 'city', 'region', 'countryCode', 'jakimZone', 'timeZoneId', 'latitude', 'longitude', 'notificationPrefs', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'email', 'avatarUrl', 'city', 'region', 'countryCode', 'jakimZone', 'timeZoneId', 'latitude', 'longitude', 'notificationPrefs', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      // --- Subcollection: /users/{userId}/prayer_logs/{logId} ---
      match /prayer_logs/{logId} {
        allow get: if isOwner(userId) && isValidId(logId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(logId) &&
                         incoming().keys().hasAll(['userId', 'prayerDate', 'prayerName', 'completed', 'prayMode', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'prayerDate', 'prayerName', 'completed', 'prayMode', 'createdAt', 'updatedAt']) &&
                         isValidPrayerLog(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(logId) &&
                         isValidPrayerLog(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().prayerDate == existing().prayerDate &&
                         incoming().prayerName == existing().prayerName &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'prayMode', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(logId);
      }

      // --- Subcollection: /users/{userId}/quran_progress/{docId} ---
      match /quran_progress/{docId} {
        allow get: if isOwner(userId) && isValidId(docId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(docId) &&
                         incoming().keys().hasAll(['userId', 'lastSurahNumber', 'lastSurahName', 'lastAyah', 'totalAyahsRead', 'khatamPercentage', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'lastSurahNumber', 'lastSurahName', 'lastAyah', 'totalAyahsRead', 'khatamPercentage', 'bookmarks', 'createdAt', 'updatedAt']) &&
                         isValidQuranProgress(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(docId) &&
                         isValidQuranProgress(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['lastSurahNumber', 'lastSurahName', 'lastAyah', 'totalAyahsRead', 'khatamPercentage', 'bookmarks', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(docId);
      }

      // --- Subcollection: /users/{userId}/tasbih_sessions/{sessionId} ---
      match /tasbih_sessions/{sessionId} {
        allow get: if isOwner(userId) && isValidId(sessionId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(sessionId) &&
                         incoming().keys().hasAll(['userId', 'dzikirTitle', 'currentCount', 'targetCount', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'dzikirTitle', 'currentCount', 'targetCount', 'createdAt', 'updatedAt']) &&
                         isValidTasbihSession(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(sessionId) &&
                         isValidTasbihSession(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['dzikirTitle', 'currentCount', 'targetCount', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(sessionId);
      }
    }
  }
}
